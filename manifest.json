{
  "name": "GH Uploader & Manager",
  "short_name": "GH Uploader",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#f6f8fa",
  "theme_color": "#2ea44f",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "shared_files",
          "accept": ["*/*"]
        }
      ]
    }
  }
}
